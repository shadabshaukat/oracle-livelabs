# Server (FastAPI)
# HOST: IP/interface the FastAPI server binds to (0.0.0.0 for all interfaces)
HOST=10.10.2.227
# PORT: TCP port for FastAPI/uvicorn
PORT=8000
# WORKERS: number of uvicorn workers (1 is best for local dev)
WORKERS=1

# Storage paths
# DATA_DIR: base directory for all app data (temp uploads, models, etc.)
DATA_DIR=storage
# UPLOAD_DIR: where user uploads are stored for ingestion
UPLOAD_DIR=storage/uploads
# MODEL_CACHE_DIR: local cache for embedding + image models
MODEL_CACHE_DIR=storage/models

# Database (choose either DATABASE_URL or the discrete params)
# DATABASE_URL: full PostgreSQL DSN (overrides DB_HOST/DB_NAME/DB_USER/DB_PASSWORD)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# DB_HOST: PostgreSQL host/IP
DB_HOST=10.10.1.77
# DB_PORT: PostgreSQL port
DB_PORT=5432
# DB_NAME: database name to connect to
DB_NAME=postgres
# DB_USER: PostgreSQL username
DB_USER=postgres
# DB_PASSWORD: PostgreSQL password
DB_PASSWORD=RAbbithole1234##
# DB_SSLMODE: sslmode parameter for PostgreSQL driver (require, disable, verify-full, ...)
DB_SSLMODE=require
# DB_POOL_MIN_SIZE: minimum connections in the psycopg pool
DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE: maximum connections in the psycopg pool
DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT_SECONDS: max wait for a pooled connection before timeout
DB_POOL_TIMEOUT_SECONDS=30
# DB_CONNECT_TIMEOUT_SECONDS: per-attempt TCP/connect timeout to PostgreSQL
DB_CONNECT_TIMEOUT_SECONDS=10
# DB_STARTUP_RETRY_ENABLED: retry DB initialization during app startup
DB_STARTUP_RETRY_ENABLED=true
# DB_STARTUP_MAX_WAIT_SECONDS: total startup wait budget for DB readiness
DB_STARTUP_MAX_WAIT_SECONDS=180
# DB_STARTUP_INITIAL_RETRY_DELAY_SECONDS: initial delay before next startup retry
DB_STARTUP_INITIAL_RETRY_DELAY_SECONDS=2
# DB_STARTUP_MAX_RETRY_DELAY_SECONDS: cap for exponential backoff delay
DB_STARTUP_MAX_RETRY_DELAY_SECONDS=15
# DB_STARTUP_BACKOFF_MULTIPLIER: exponential backoff multiplier
DB_STARTUP_BACKOFF_MULTIPLIER=1.8

# Embeddings (text)
# EMBEDDING_MODEL: sentence-transformers model used for text embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM: embedding dimensionality (must match model output)
EMBEDDING_DIM=384
# EMBEDDING_BATCH: batch size for embedding generation
EMBEDDING_BATCH=64

# pgvector index tuning
# PGVECTOR_METRIC: cosine | l2 | ip (similarity metric)
PGVECTOR_METRIC=cosine
# PGVECTOR_LISTS: IVFFlat index lists (roughly sqrt(num_vectors))
PGVECTOR_LISTS=1000
# PGVECTOR_PROBES: runtime probes for IVFFlat (higher = more accurate, slower)
PGVECTOR_PROBES=25

# Full-text search config
# FTS_CONFIG: PostgreSQL text search configuration (english, simple, etc.)
FTS_CONFIG=english

# Security (Basic Auth for API fallback)
# BASIC_AUTH_USER: username for HTTP Basic Auth when used
BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD: password for HTTP Basic Auth when used
BASIC_AUTH_PASSWORD=letmein

# Session cookie auth (used by UI login/register)
# SECRET_KEY: used to sign session cookies (rotate in production)
SECRET_KEY=change-me
# SESSION_COOKIE_NAME: cookie name for session
SESSION_COOKIE_NAME=searchapp_session
# SESSION_MAX_AGE_SECONDS: session lifetime in seconds
SESSION_MAX_AGE_SECONDS=604800
# SESSION_ACTIVITY_TTL_SECONDS: activity/session timeout in seconds
SESSION_ACTIVITY_TTL_SECONDS=28800
# COOKIE_SAMESITE: cookie samesite attribute (lax|strict|none)
COOKIE_SAMESITE=lax
# COOKIE_SECURE: whether to set Secure flag on cookies
COOKIE_SECURE=false
# ALLOW_REGISTRATION: allow new users to register
ALLOW_REGISTRATION=true

# Optional LLM for RAG synthesis
# LLM_PROVIDER: none | openai | oci (controls RAG response synthesis)
LLM_PROVIDER=oci
# OPENAI_API_KEY: OpenAI API key (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
# OPENAI_MODEL: OpenAI model name to call
OPENAI_MODEL=gpt-4o-mini
# RAG_MAX_TOKENS: token budget for RAG responses
RAG_MAX_TOKENS=1024

# AWS Bedrock (optional)
AWS_REGION=
AWS_BEDROCK_MODEL_ID=

# Ollama (optional)
OLLAMA_HOST=
OLLAMA_MODEL=

# OCI Generative AI (when LLM_PROVIDER=oci)
# OCI_REGION: OCI region for GenAI endpoint
OCI_REGION=us-ashburn-1
# OCI_COMPARTMENT_OCID: target compartment for OCI GenAI
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaaaaaadfdmligjm7aefhatq6n5s2stavjgfq56n7vbnhjpxry7tiqjgmfa
# OCI_GENAI_ENDPOINT: inference endpoint URL
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
# OCI_GENAI_MODEL_ID: GenAI model OCID
OCI_GENAI_MODEL_ID=ocid1.generativeaimodel.oc1.us-chicago-1.amaaaaaask7dceyayjawvuonfkw2ua4bob4rlnnlhs522pafbglivtwlfzta
# OCI_CONFIG_FILE: path to OCI config file (for config-based auth)
OCI_CONFIG_FILE=/home/opc/.oci/config
# OCI_CONFIG_PROFILE: profile in OCI config file
OCI_CONFIG_PROFILE=DEFAULT
# OCI_TENANCY_OCID: tenancy OCID (API key auth)
OCI_TENANCY_OCID=
# OCI_USER_OCID: user OCID (API key auth)
OCI_USER_OCID=
# OCI_FINGERPRINT: API key fingerprint
OCI_FINGERPRINT=
# OCI_PRIVATE_KEY_PATH: private key path for API key auth
OCI_PRIVATE_KEY_PATH=
# OCI_PRIVATE_KEY_PASSPHRASE: private key passphrase
OCI_PRIVATE_KEY_PASSPHRASE=

# CORS (set to false to disable)
# ALLOW_CORS: allow cross-origin requests for API
ALLOW_CORS=true

# Upload & parsing
# MAX_UPLOAD_SIZE_MB: maximum upload size per file in MB
MAX_UPLOAD_SIZE_MB=50
# MAX_FILES_PER_SPACE: maximum number of files allowed per space
MAX_FILES_PER_SPACE=100
# ALLOWED_UPLOAD_EXTENSIONS: comma-separated list (".pdf,.docx"), blank for all
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md,.ppt,.pptx,.xls,.xlsx,.csv,.png,.jpg,.jpeg,.gif
# USE_PYMUPDF: enable PyMuPDF for better PDF extraction (requires pdf extra)
USE_PYMUPDF=true
# DELETE_UPLOADED_FILES: delete local file after ingest
DELETE_UPLOADED_FILES=false

# Image search + storage (pgvector + OpenCLIP)
# ENABLE_IMAGE_STORAGE: ingest images + store embeddings for image search
ENABLE_IMAGE_STORAGE=true
# IMAGE_EMBED_MODEL: OpenCLIP model name
IMAGE_EMBED_MODEL=openclip/ViT-L-14
# IMAGE_EMBED_DIM: embedding dimension for the image model
IMAGE_EMBED_DIM=768
# IMAGE_EMBED_DEVICE: cpu | cuda | mps
IMAGE_EMBED_DEVICE=cpu
# IMAGE_SEARCH_TEXT_WEIGHT: weight for caption/tags similarity
IMAGE_SEARCH_TEXT_WEIGHT=0.3
# IMAGE_SEARCH_VECTOR_WEIGHT: weight for vector similarity
IMAGE_SEARCH_VECTOR_WEIGHT=0.7
# IMAGE_KEYWORD_MAX: max number of keywords derived from caption
IMAGE_KEYWORD_MAX=16

# Image captioning (LLaVA/BLIP)
# ENABLE_IMAGE_CAPTIONING: enable caption generation during image ingest
ENABLE_IMAGE_CAPTIONING=true
# IMAGE_CAPTION_MODEL: heavy LLaVA model (GPU recommended)
IMAGE_CAPTION_MODEL=llava-hf/llava-1.5-7b-hf
# IMAGE_CAPTION_MODEL_SMALL: CPU-friendly BLIP model
IMAGE_CAPTION_MODEL_SMALL=Salesforce/blip-image-captioning-base
# IMAGE_CAPTION_USE_SMALL: true to force the lightweight model
IMAGE_CAPTION_USE_SMALL=true
# IMAGE_CAPTION_DEVICE: cpu | cuda | mps
IMAGE_CAPTION_DEVICE=cpu
# IMAGE_CAPTION_MAX_TOKENS: max tokens for caption generation
IMAGE_CAPTION_MAX_TOKENS=120
# IMAGE_CAPTION_PROMPT: prompt for LLaVA-style captioning
IMAGE_CAPTION_PROMPT="Describe the image in detail."
# IMAGE_CAPTION_TIMEOUT_S: timeout for captioning
IMAGE_CAPTION_TIMEOUT_S=60

# OCR (image text extraction)
# OCR_ENABLED: enable OCR for text detected in images
OCR_ENABLED=true
# OCR_ENGINE: OCR backend (tesseract)
OCR_ENGINE=tesseract
# OCR_MIN_CHARS: minimum characters to keep OCR text
OCR_MIN_CHARS=12
# OCR_MAX_CHARS: maximum characters to keep OCR text
OCR_MAX_CHARS=8000

# NL2SQL system prompt (SQL Search)
# SQL_SYSTEM_PROMPT: system instruction for NL2SQL generation
SQL_SYSTEM_PROMPT="You are an expert PostgreSQL (v14-v18) SQL assistant. Produce accurate, executable SELECT-only SQL and never hallucinate tables or columns. Use only the provided schema/context. If needed, re-check the schema before answering."
# SQL_MAX_ROWS: upper limit enforced server-side for SQL Search results
SQL_MAX_ROWS=200
# SQL_DEFAULT_ROWS: default max rows used by SQL Search UI (must be <= SQL_MAX_ROWS)
SQL_DEFAULT_ROWS=200
# SQL_MEMORY_TURNS: number of prior SQL questions retained as context (0 disables)
SQL_MEMORY_TURNS=8
# SQL_AGENTIC_MODE_DEFAULT: default for agentic SQL retry flow when request omits agentic_mode
SQL_AGENTIC_MODE_DEFAULT=true
# SQL_AGENTIC_MAX_RETRIES: max retry attempts for agentic SQL correction (kept low for latency)
SQL_AGENTIC_MAX_RETRIES=1
# SQL_AGENTIC_SAMPLE_ROWS: number of sampled rows per table used in agentic retry prompting
SQL_AGENTIC_SAMPLE_ROWS=3
# SQL_AGENTIC_SAMPLE_MAX_TABLES: max sampled tables used in agentic retry prompting
SQL_AGENTIC_SAMPLE_MAX_TABLES=3
# SQL_PERSISTENT_MEMORY_ENABLED: enable persistent memory for SQL Search (requires DB table)
SQL_PERSISTENT_MEMORY_ENABLED=true
# TEXT_PERSISTENT_MEMORY_ENABLED: enable persistent memory for Text Search
TEXT_PERSISTENT_MEMORY_ENABLED=true
# IMAGE_PERSISTENT_MEMORY_ENABLED: enable persistent memory for Image Search
IMAGE_PERSISTENT_MEMORY_ENABLED=true
# PERSISTENT_MEMORY_TOP_K: number of memory records to retrieve
PERSISTENT_MEMORY_TOP_K=8
# PERSISTENT_MEMORY_MAX_CHARS: max chars for memory context injection
PERSISTENT_MEMORY_MAX_CHARS=4000
# PERSISTENT_MEMORY_SUMMARY_MAX_CHARS: max chars for summarized memory
PERSISTENT_MEMORY_SUMMARY_MAX_CHARS=1200

# Deep Research (agentic retrieval + synthesis controls)
# DR_RERANK_ENABLE: enables second-pass reranking of retrieved contexts for better relevance ordering
DR_RERANK_ENABLE=true
# DR_TOPIC_LOCK_DEFAULT: when true, keeps a stricter focus on current thread/topic across turns
DR_TOPIC_LOCK_DEFAULT=false
# DEEP_RESEARCH_TIMEOUT_SECONDS: total time budget (seconds) for one deep research answer
DEEP_RESEARCH_TIMEOUT_SECONDS=120
# DEEP_RESEARCH_LOCAL_TOP_K: max local KB chunks retrieved per query/sub-query
DEEP_RESEARCH_LOCAL_TOP_K=15
# DEEP_RESEARCH_WEB_TOP_K: max web results considered when web search is triggered
DEEP_RESEARCH_WEB_TOP_K=15
# DEEP_RESEARCH_URL_MAX_DEPTH: crawl depth limit when ingesting user-provided URLs
DEEP_RESEARCH_URL_MAX_DEPTH=2
# DEEP_RESEARCH_URL_MAX_PAGES: max pages to ingest from provided URLs per request
DEEP_RESEARCH_URL_MAX_PAGES=12
# DEEP_RESEARCH_RETRY_LOOPS: extra agentic retrieval/synthesis retries when confidence is low
DEEP_RESEARCH_RETRY_LOOPS=1
# DEEP_RESEARCH_CONFIDENCE_THRESHOLD: confidence floor used to stop retry loops early
DEEP_RESEARCH_CONFIDENCE_THRESHOLD=0.45
# DEEP_RESEARCH_MISSING_CONCEPT_LOOPS: iterations to detect/fill missing concepts from context gaps
DEEP_RESEARCH_MISSING_CONCEPT_LOOPS=1
# DEEP_RESEARCH_MISSING_CONCEPT_TOP_K: cap on missing concepts expanded per loop
DEEP_RESEARCH_MISSING_CONCEPT_TOP_K=6
# DEEP_RESEARCH_RECENCY_BOOST: weighting boost for recently ingested docs when ranking local refs
DEEP_RESEARCH_RECENCY_BOOST=0.15
# DEEP_RESEARCH_RECENCY_HALF_LIFE_DAYS: recency decay half-life for local evidence ranking
DEEP_RESEARCH_RECENCY_HALF_LIFE_DAYS=30
# DEEP_RESEARCH_FOLLOWUP_ENABLE: enables clarifying follow-up question generation
DEEP_RESEARCH_FOLLOWUP_ENABLE=true
# DEEP_RESEARCH_FOLLOWUP_THRESHOLD: ask follow-ups when confidence falls below this threshold
DEEP_RESEARCH_FOLLOWUP_THRESHOLD=0.4
# DEEP_RESEARCH_FOLLOWUP_MAX_QUESTIONS: max follow-up questions suggested per turn
DEEP_RESEARCH_FOLLOWUP_MAX_QUESTIONS=2
# DEEP_RESEARCH_FOLLOWUP_AUTOSEND: auto-send follow-up response payload when UI supports it
DEEP_RESEARCH_FOLLOWUP_AUTOSEND=true
# DEEP_RESEARCH_FOLLOWUP_RELEVANCE_MIN: minimum semantic relevance score for follow-up suggestions
DEEP_RESEARCH_FOLLOWUP_RELEVANCE_MIN=0.08
# DEEP_RESEARCH_PERSISTENT_MEMORY_ENABLED: enables thumbs-up memory persistence in deep research mode
DEEP_RESEARCH_PERSISTENT_MEMORY_ENABLED=true
# DEEP_RESEARCH_PERSISTENT_MEMORY_TOP_K: memory entries retrieved as additional long-term context
DEEP_RESEARCH_PERSISTENT_MEMORY_TOP_K=8
# DEEP_RESEARCH_PERSISTENT_MEMORY_MAX_CHARS: max characters injected from persistent memory context
DEEP_RESEARCH_PERSISTENT_MEMORY_MAX_CHARS=6000
# DEEP_RESEARCH_MEMORY_ROLLUP_ENABLED: periodically stores conversation rollup summaries in memory
DEEP_RESEARCH_MEMORY_ROLLUP_ENABLED=true
# DEEP_RESEARCH_MEMORY_ROLLUP_EVERY_N: create rollup every N deep research messages
DEEP_RESEARCH_MEMORY_ROLLUP_EVERY_N=6
# DEEP_RESEARCH_MEMORY_ROLLUP_MIN_MESSAGES: minimum messages before rollup becomes eligible
DEEP_RESEARCH_MEMORY_ROLLUP_MIN_MESSAGES=6
# DEEP_RESEARCH_MEMORY_ROLLUP_MAX_CHARS: max chars from conversation included in rollup input
DEEP_RESEARCH_MEMORY_ROLLUP_MAX_CHARS=12000

# Storage backend: local | oci | s3 | both
# STORAGE_BACKEND: where uploads live (local only, object storage only, or both)
STORAGE_BACKEND=oci
# OBJECT_STORAGE_PROVIDER: required when STORAGE_BACKEND=both (oci or s3)
OBJECT_STORAGE_PROVIDER=oci
# OCI_OS_BUCKET_NAME: OCI bucket name for uploads (when provider is oci)
OCI_OS_BUCKET_NAME=search-app-uploads
# S3 configuration (when provider is s3)
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Chunking (ingestion)
# CHUNK_SIZE: chunk size in characters
CHUNK_SIZE=2500
# CHUNK_OVERLAP: overlap in characters between chunks
CHUNK_OVERLAP=250
# CHUNK_STRATEGY: recursive | sentence_pack (paragraph → sentence → pack)
CHUNK_STRATEGY=sentence_pack
# SENTENCE_SPLITTER: regex | nltk | spacy
SENTENCE_SPLITTER=nltk
